# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Cloudflare Turnstile
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=
TURNSTILE_ALLOWED_HOSTNAMES=westernaverages.xyz

# Server-side abuse prevention (use independent random values of 32+ characters)
ABUSE_PREVENTION_SECRET=
ANALYTICS_SECRET=

# Exact comma-separated origins allowed to POST to the API routes
ALLOWED_ORIGINS=https://westernaverages.xyz

# Enable only behind a trusted non-Netlify proxy that overwrites X-Forwarded-For
TRUST_PROXY_HEADERS=false

# Google Analytics 4
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Microsoft Clarity
NEXT_PUBLIC_CLARITY_PROJECT_ID=
